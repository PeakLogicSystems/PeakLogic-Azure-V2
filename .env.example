# AWS credentials — configure via `aws configure` or IAM role, not here
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1

# Set by CDK outputs after deploy — used by local dev / CI
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/v1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_REGION=us-east-1
