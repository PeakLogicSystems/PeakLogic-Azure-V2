# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Derived adapter for publishing the architecture diagram as a Claude
# Artifact — regenerate via docs/business/_docgen/build-artifact-export.mjs,
# not an investor deliverable in its own right, don't hand-edit or commit.
docs/business/_docgen/artifact-export.html

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
cdk.context.json
# AWS's public RDS CA bundle — not a secret (no private key material), and
# needed at runtime by backend/shared/db.ts for real TLS cert validation
# (Security Architecture §4.2) — must be committed despite the *.pem rule above.
!backend/shared/certs/rds-global-bundle.pem

# AWS CDK
cdk.out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Test coverage
coverage/
.nyc_output/

# Device certificates — contain private keys, never commit
device-certs/

# Claude Code internal files — session memory and local settings, not application code
.claude/

# Vite dev-server dependency cache (build artifact)
.vite/
**/.vite/
