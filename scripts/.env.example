# ─────────────────────────────────────────────────────────────────────────────
# PeakLogic Provisioning Script — environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region (must match where CDK was deployed)
AWS_REGION=us-east-1

# ── DB connection ─────────────────────────────────────────────────────────────
# Choose ONE approach:

# Option A: Direct connection (local dev with `docker compose up db`)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peaklogic
DB_USER=peaklogic_admin
DB_PASSWORD=localdev
DB_SSL=false

# Option B: Via Secrets Manager (staging / production)
# Requires network access to the RDS instance (VPN, bastion, or RDS Proxy).
# DB_HOST=<value from CDK output PeakLogic-Data.DbHost>
# DB_SECRET_ARN=<value from CDK output PeakLogic-Data.DbSecretArn>
# Unset DB_PASSWORD when using this option.
