# IoT Edge module build/deploy configuration.
# Copy this to `.env` (which is gitignored — NEVER commit real registry creds)
# and fill in. Consumed by the ${...} tokens in deployment.template.json and
# module.json when the IoT Edge tooling (iotedgedev / az iot edge) genconfigs.

# Your container registry (e.g. an Azure Container Registry login server).
CONTAINER_REGISTRY_SERVER=youracr.azurecr.io
CONTAINER_REGISTRY_USERNAME=
CONTAINER_REGISTRY_PASSWORD=
