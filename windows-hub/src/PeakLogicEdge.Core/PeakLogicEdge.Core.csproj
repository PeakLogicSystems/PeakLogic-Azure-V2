<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the hub agent runs on BOTH Windows 11 and Linux
         (dual-platform-hub-design.md). `net8.0` is the portable surface the
         Linux hub (Azure IoT Edge module) builds against; `net8.0-windows`
         additionally compiles the two genuinely Windows-only pieces below.
         Everything else in Core — SQLite cache, MQTT, HTTP backend client,
         Modbus/OPC-UA/REST ingestion, normalization, PeakAssist sync, edge
         alarms — is portable and builds under both. -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PeakLogicEdge.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local caching: durable queue (§4) — cross-platform -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- Outbound MQTT publishing (§5.1) — cross-platform -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- Structured logging — cross-platform -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <!-- Windows-only surface: DPAPI secret storage (§9.3) and serial ingestion
       (§2.2). Both are behind seams (ISecretStore / IIngestionSource), so the
       portable build simply omits these implementations; a Linux secret store
       and, if needed, a Linux serial source are separate impls of the same
       seams (dual-platform-hub-design.md §4). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="Security/DpapiSecretStore.cs" />
    <Compile Remove="Ingestion/SerialIngestionSource.cs" />
  </ItemGroup>

</Project>
