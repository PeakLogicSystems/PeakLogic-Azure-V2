<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Portable net8.0: a thin dev console harness over the shared HubAgent
         (Core), so it's now cross-platform too and no longer a second copy of
         the pipeline. The production headless runtime is PeakLogicEdge.Agent
         (service-hostable); this stays as the `dotnet run` dev/testing entry
         point over the exact same agent. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PeakLogicEdge.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeakLogicEdge.Core\PeakLogicEdge.Core.csproj" />
  </ItemGroup>

</Project>
