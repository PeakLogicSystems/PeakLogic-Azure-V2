<Window
    x:Class="PeakLogicEdge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView x:Name="Nav"
                     IsBackButtonVisible="Collapsed"
                     IsSettingsVisible="False"
                     SelectionChanged="Nav_SelectionChanged"
                     Loaded="Nav_Loaded">
        <NavigationView.MenuItems>
            <!-- Screen inventory per architecture doc S6.2, mirrors the
                 tenant web app's Dashboard/Sites/Alerts/Tickets/Settings,
                 plus Ingestion Health under Settings (endpoint-local, no
                 web-app equivalent). Site/Asset/Device drill-down needs
                 real backend data that doesn't exist yet, so Sites shows
                 an honest "not available" placeholder rather than fake
                 mock data, per this project's own established rule
                 against repeating the tenant frontend's mock-data gap. -->
            <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
            <NavigationViewItem Content="Sites" Tag="sites" Icon="MapPin" />
            <NavigationViewItem Content="Alerts" Tag="alerts" Icon="Important" />
            <NavigationViewItem Content="Tickets" Tag="tickets" Icon="Repair" />
            <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
