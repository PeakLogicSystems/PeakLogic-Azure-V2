<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Architecture doc S6.3: touch-first minimum tap targets (48px+),
      generous spacing, no hover-only affordances. This is the single
      touch-first baseline for this pass; the full runtime touch/pointer
      switching (InputModeService swapping Styles.Touch.xaml /
      Styles.Pointer.xaml at the NavigationView root) is NOT implemented
      here, a real, disclosed gap, not an oversight. See
      windows-hub/README.md's status table.
    -->

    <x:Double x:Key="TouchMinTapTarget">48</x:Double>

    <Style x:Key="TouchButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}" />

    <Style x:Key="TouchListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</ResourceDictionary>
