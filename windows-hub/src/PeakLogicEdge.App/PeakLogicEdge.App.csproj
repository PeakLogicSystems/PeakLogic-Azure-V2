<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PeakLogicEdge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Unpackaged (no MSIX) for now. Architecture doc S11.1's own
         build sequence puts MSIX packaging last, step 7, once the app's
         shape is stable. Bundling the Windows App SDK runtime into the
         app itself (WindowsAppSDKSelfContained) avoids requiring a
         separate runtime installer on a hub device, matching the
         self-contained deploy approach already used for
         PeakLogicEdge.Host. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Windows.SDK.BuildTools is a transitive dependency of
         Microsoft.WindowsAppSDK, left unpinned deliberately: a first,
         explicit pin here caused a NU1605 package downgrade error against
         what WindowsAppSDK 2.2.0 actually needs transitively; simpler and
         more correct to let NuGet resolve it. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeakLogicEdge.Core\PeakLogicEdge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App-local Visual C++ Redistributable (x64) DLLs, vendored directly
         instead of requiring a separate vc_redist.x64.exe install on the
         hub device. WindowsAppSDKSelfContained bundles the Windows App SDK
         framework, but the SDK's own native components still link against
         the VC++ runtime, which is not part of that bundle: confirmed
         2026-07-16 by inspecting a real publish output (no vcruntime140.dll
         / msvcp140.dll present) after a hub device failed to launch the app
         with zero visible error. Microsoft explicitly documents app-local
         (xcopy) deployment of these exact files as a supported alternative
         to the system-wide installer: https://learn.microsoft.com/en-us/cpp/windows/redistributing-visual-cpp-files
         This matters here specifically because the hub device this app
         actually runs on is managed by someone without local admin rights
         to run an installer, so app-local deployment needs none. -->
    <None Include="redist\x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Flattened to the output root, not redist\x64\: the OS DLL
           search order only checks the exe's own directory, not
           subfolders, so these have to land right next to the exe. -->
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
