<Page
    x:Class="PeakLogicEdge.App.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Alerts" Style="{StaticResource PageTitleStyle}" />
        <InfoBar IsOpen="True" Severity="Informational"
                 Title="Requires a connected backend"
                 Message="Alerts are evaluated by the cloud platform's rule engine against real telemetry. This screen will show live alerts for this site once a real device is wired up and this hub is connected to a deployed backend." />
    </StackPanel>
</Page>
