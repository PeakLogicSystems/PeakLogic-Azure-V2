<Page
    x:Class="PeakLogicEdge.App.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Alerts" Style="{StaticResource PageTitleStyle}" />

            <InfoBar IsOpen="True" Severity="Informational"
                     Title="Local alerts only"
                     Message="These are raised by a local demo threshold check standing in for the real cloud rule engine, which will supersede this once a backend is deployed. Clearing an alert here dismisses it on this device only." />

            <TextBlock Text="Active Alerts" Style="{StaticResource SectionTitleStyle}" />
            <ListView x:Name="AlertsList"
                      ItemContainerStyle="{StaticResource TouchListViewItemStyle}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RaisedAt}" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Severity}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ThingName}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="Clear" Tag="{Binding Id}" Click="ClearButton_Click" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText" Text="No active alerts." Opacity="0.6" Margin="0,16,0,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
