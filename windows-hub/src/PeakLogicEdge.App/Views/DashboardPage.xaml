<Page
    x:Class="PeakLogicEdge.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SiteNameText" Text="Site" Opacity="0.75" FontWeight="SemiBold" Margin="0,-12,0,16" />

            <InfoBar IsOpen="True" Severity="Informational"
                     Title="No cloud backend connected"
                     Message="Readings are being durably queued locally and are not yet being published — this is expected until a real AWS backend is deployed." />

            <TextBlock Text="Local Queue" Style="{StaticResource SectionTitleStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="24" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="PendingCountText" Text="0" Style="{StaticResource MetricValueStyle}" />
                    <TextBlock Text="readings durably queued, awaiting a backend to publish to" Style="{StaticResource MetricLabelStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Recent Readings" Style="{StaticResource SectionTitleStyle}" />
            <ListView x:Name="ReadingsList"
                      ItemContainerStyle="{StaticResource TouchListViewItemStyle}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ObservedAt}" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="{Binding ThingName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding MetricsSummary}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
