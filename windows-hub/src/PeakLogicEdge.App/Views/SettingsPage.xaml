<Page
    x:Class="PeakLogicEdge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20,16" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch x:Name="DarkModeToggle" Header="Dark mode" MinHeight="48" Toggled="DarkModeToggle_Toggled" />
                </StackPanel>
            </Border>

            <!-- Architecture doc S6.2: "Settings to Ingestion Health (COM
                 ports / LAN endpoints status, endpoint-local, not in the
                 web app)". This is real, live data from the actual
                 IngestionOrchestrator running in this process, not a
                 placeholder, unlike Sites/Alerts/Tickets. -->
            <TextBlock Text="Ingestion Health" Style="{StaticResource SectionTitleStyle}" />
            <ListView x:Name="HealthList"
                      ItemContainerStyle="{StaticResource TouchListViewItemStyle}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Kiosk Provisioning" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar IsOpen="True" Severity="Informational"
                     Title="Not built yet"
                     Message="Assigned Access / Shell Launcher kiosk-mode provisioning and the Watchdog supervisor service (architecture doc §11.1, steps 6-7) are separate, not-yet-started pieces of work." />
        </StackPanel>
    </ScrollViewer>
</Page>
